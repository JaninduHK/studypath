# Copy to .env.local for local development.
# docker-compose up -d starts postgres + redis with these matching credentials.

# --- Database ---
DATABASE_URL="postgresql://studienpfad:studienpfad@localhost:5432/studienpfad"

# --- Redis / background jobs (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- File storage (S3-compatible, EU region) ---
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments (Stripe Connect) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
